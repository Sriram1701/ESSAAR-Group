# Clean URLs for ESSAAR Group
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirect /index.html and /index to clean root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s?] [NC]
  RewriteRule ^index(\.html)?$ / [R=301,L]

  # 2. Redirect *.html requests to clean URL (301)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^/]+)\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # 3. Strip trailing slashes from non-directories
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # 4. Resolve clean URLs to .html files internally
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Custom 404 page
  ErrorDocument 404 /404.html
</IfModule>
